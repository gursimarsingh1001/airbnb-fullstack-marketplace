# This file documents backend settings; environment variables must be exported
# in the shell or hosting dashboard. The backend does not load dotenv files.

# Default: backend/airbnb.db. Use an absolute path for a persistent deployment.
# DATABASE_PATH=/absolute/persistent/path/airbnb.db

# Only needed when frontend and backend have different origins.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Leave disabled for local SQLite, pytest, and Docker persistent-volume use.
DATABASE_BLOB_ENABLED=0

# Free Vercel demo only: enable snapshots and connect a PRIVATE Blob store.
# DATABASE_BLOB_ENABLED=1
# BLOB_READ_WRITE_TOKEN=<provided-by-vercel-storage-connection>
# Never prefix a backend secret with NEXT_PUBLIC_ or commit real credentials.
