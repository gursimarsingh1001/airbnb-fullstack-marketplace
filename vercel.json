{
  "version": 2,
  "builds": [
    {"src": "frontend/package.json", "use": "@vercel/static-build", "config": {"distDir": "out", "routePrefix": "/"}},
    {"src": "api/index.py", "use": "@vercel/python", "config": {"includeFiles": ["backend/**"]}}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.py"},
    {"src": "/docs", "dest": "/api/index.py"},
    {"src": "/openapi.json", "dest": "/api/index.py"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
